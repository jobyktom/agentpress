{
  "name": "agentpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentPress - build, deploy and monitor AI agents across every channel.",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web install --include=dev && npm --prefix web run build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --no-warnings --test server/test/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0"
  }
}
