# Port the server listens on (Hostinger and most hosts set this for you)
PORT=3000

# Public https URL of your site. Used to build channel webhook URLs.
PUBLIC_URL=https://agentpress.example.com

# Where the SQLite database lives. Keep it outside the app folder on hosts
# that replace the folder on every deploy.
AGENTPRESS_DB=data/agentpress.db

# Optional: enables full generative replies and tool use. Without it, agents
# answer from knowledge and playbooks only.
ANTHROPIC_API_KEY=

# Set to 0 to skip creating the demo account on first start.
SEED_DEMO=1

# Optional: agent shown in the marketing site's live chat bubble.
DEMO_AGENT_ID=
